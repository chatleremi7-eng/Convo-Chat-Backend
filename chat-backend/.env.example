PORT=3000
NODE_ENV=development
JWT_SECRET=replace-this-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173
# Choose: sqlite or postgres
DB_CLIENT=sqlite
SQLITE_PATH=./data/chat.sqlite
# For PostgreSQL, set DB_CLIENT=postgres and provide DATABASE_URL:
# DATABASE_URL=postgres://chatuser:chatpassword@postgres:5432/chatdb
